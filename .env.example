# Mkfd Environment Variables
# Copy this file to .env and REPLACE every value below.
#
# The placeholders are deliberately not runnable. Generate each secret with:
#
#   openssl rand -base64 32
#
# Do not shorten COOKIE_SECRET. Session cookies are encrypted with it, and a
# value under 32 characters fails on the first request rather than at startup —
# so the app appears to boot, reports healthy, then returns 500 for every page.

# Required: Passkey for API authentication
PASSKEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Required: Cookie secret. MUST be at least 32 characters.
COOKIE_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Required: Encryption key for stored credentials (IMAP passwords, proxy auth).
# A known value exposes every credential the app has stored.
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Optional: Enable SSL (true/false)
SSL=false

# Optional: Server port (defaults to 5000)
PORT=5000

# Optional: Path to Chrome extensions directory for advanced scraping
# Place unpacked extensions in subdirectories within this path
# Example: /app/extensions/extension1, /app/extensions/extension2
# Defaults to /app/extensions if not set
# Docker: /app/extensions (default - no need to set this)
# Local: /full/path/to/mkfd/extensions
# CHROME_EXTENSIONS_PATH=/app/extensions

# Optional: Override default 4GB memory allocation for IMAP processes
# Uncomment and adjust if you have large mailboxes
# NODE_OPTIONS=--max-old-space-size=8192
