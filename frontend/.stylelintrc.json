{
  "extends": [
    "stylelint-config-standard",
    "@double-great/stylelint-a11y/recommended"
  ],
  "ignoreFiles": [
    "../public/**",
    "dist/**",
    "node_modules/**"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "screen",
          "variants",
          "responsive"
        ]
      }
    ],
    "no-descending-specificity": null,
    "import-notation": null,
    "at-rule-prelude-no-invalid": null,
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": [
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Geist",
          "Figtree"
        ]
      }
    ]
  }
}
