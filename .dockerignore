# Frontend source code (only built files in /public are needed)
frontend/node_modules
frontend/src
frontend/.vite
frontend/*.config.ts
frontend/*.config.js
frontend/tsconfig.json
frontend/tsconfig.node.json
frontend/index.html
frontend/components.json
frontend/package.json
frontend/bun.lockb

# Git and version control
.git
.gitignore
.gitmodules

# Documentation
README.md
*.md

# Environment files
.env
.env.example

# Cache and temp files
node_modules/.cache
.DS_Store
*.log

# TrueNAS folder if present
truenas/

# Build artifacts that shouldn't be in Docker
dist/
build/
public/feeds
configs/

# Dependencies are installed inside the image by `bun install --frozen-lockfile`.
# Copying the build host's tree would overwrite that Linux dependency tree with
# whatever the host happens to have — Windows-native on this project's own
# development machine — silently discarding the frozen-lockfile guarantee.
node_modules

# Runtime state and development artefacts. .tdd-state holds TDD session
# artefacts including full model responses; none of this belongs in a
# published image.
feed-state/
tests/
.tdd-state/
