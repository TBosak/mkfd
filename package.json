{
  "name": "mkfd",
  "module": "index.ts",
  "type": "module",
  "version": "2.1.2",
  "description": "Self-hosted feed generation toolkit for turning webpages, email folders, APIs, and messy web sources into reliable RSS feeds.",
  "scripts": {
    "build": "cd frontend && bun run build",
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "lint": "bun scripts/run-quality.ts lint",
    "lint:root": "bun scripts/run-quality.ts lint-root",
    "lint:frontend": "bun scripts/run-quality.ts lint-frontend",
    "typecheck": "bun scripts/run-quality.ts typecheck",
    "typecheck:root": "bun scripts/run-quality.ts typecheck-root",
    "typecheck:frontend": "bun scripts/run-quality.ts typecheck-frontend",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "validate:catalog": "bun scripts/validate-community-catalog.ts",
    "test": "bun test tests/",
    "test:e2e": "bun run build && cd frontend && bun run test",
    "verify:static": "bun run lint && bun run typecheck",
    "verify:core": "bun run verify:static && bun run test && bun run validate:catalog && bun run build",
    "verify:full": "bun run verify:core && bun run test:e2e",
    "tdd:claude": "bun scripts/claude-test-author.ts",
    "tdd:tests": "bun scripts/tdd-test-lock.ts",
    "analyze": "bun x fallow --fail-on-issues",
    "migrate:protected-values": "bun scripts/migrate-protected-values.ts",
    "agents:apply": "bunx ruler apply --skills=false --gitignore=false",
    "agents:check": "bun scripts/agents-check.ts",
    "check:invariants": "ast-grep scan",
    "check:fast": "bun run verify:static",
    "check:structural": "bun x fallow --fail-on-issues",
    "check:security": "bun scripts/check-security.ts",
    "test:mutation": "bunx stryker run",
    "test:mutation:incremental": "bunx stryker run --incremental",
    "check": "bun run check:fast && bun run check:structural && bun run test"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "domhandler": "^5.0.3",
    "drizzle-orm": "^0.45.2",
    "feed": "^5.1.0",
    "hono": "^4.13.5",
    "hono-sessions": "^0.8.1",
    "js-yaml": "^4.3.2",
    "mailparser": "^3.9.20",
    "minimist": "^1.2.8",
    "node-forge": "^1.3.1",
    "node-imap": "^0.9.6",
    "patchright": "^1.51.3",
    "re2js": "^2.8.6",
    "striptags": "^3.2.0",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@intellectronica/ruler": "0.3.44",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "^1.1.12",
    "@types/js-yaml": "4.0.9",
    "@types/libmime": "5.3.0",
    "@types/mailparser": "3.4.6",
    "@types/minimist": "1.2.5",
    "@types/node-forge": "1.3.14",
    "@types/node-imap": "^0.9.3",
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.22.0",
    "lefthook": "^2.1.12",
    "typescript": "5.7.3"
  },
  "overrides": {
    "semver": "^5.7.2",
    "undici": "^7.29.0"
  }
}
